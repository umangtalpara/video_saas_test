{
  "version": "1.1.0",
  "project": {
    "name": "SaaS AI Factory",
    "description": "Autonomous multi-agent software factory for PRD-to-SaaS application development",
    "organization": "ProvenPeak Solutions",
    "created": "2026-05-25"
  },
  "agents": {
    "super-agent": {
      "role": "Master Controller & Orchestrator",
      "file": "agents/super-agent.md"
    },
    "deep-plan-agent": {
      "role": "Strategic Planning & Architecture",
      "file": "agents/deep-plan-agent.md"
    },
    "backend-agent": {
      "role": "Backend Development",
      "file": "agents/backend-agent.md"
    },
    "frontend-agent": {
      "role": "Frontend Development",
      "file": "agents/frontend-agent.md"
    },
    "qa-agent": {
      "role": "Quality Assurance & Testing",
      "file": "agents/qa-agent.md"
    },
    "code-review-agent": {
      "role": "Code Review & Security Audit",
      "file": "agents/code-review-agent.md"
    }
  },
  "workflow": {
    "pipeline": [
      "prd-to-plan",
      "roadmap-to-phase",
      "phase-execution",
      "testing",
      "deployment"
    ],
    "require_approval": {
      "_note": "Human approval gates enforced by status-manager.js. Set to false to let the agent continue on its own.",
      "plan": true,
      "between_phases": true
    },
    "maintenance": [
      "bug-fix",
      "feature-addition"
    ]
  },
  "tech_stack": {
    "_note": "Supported defaults. The stack actually chosen for a project is recorded in .ai/memory/state.json -> stack (set via status-manager.js set-stack).",
    "backend": {
      "runtime": "Node.js 24 LTS",
      "framework": "NestJS 11.x",
      "language": "TypeScript 5.x",
      "databases": [
        "MongoDB 7.x (Mongoose 8.x)",
        "PostgreSQL / MySQL (Prisma 5.x)"
      ],
      "cache": "Redis 7.x or local in-memory",
      "queue": "BullMQ (Redis-backed) or @nestjs/schedule when Redis is not chosen",
      "containerization": "Docker (optional)",
      "api_docs": "Swagger/OpenAPI 3.0"
    },
    "frontend": {
      "framework": "Next.js 14.x",
      "library": "React 18.x",
      "language": "TypeScript 5.x",
      "styling": "Tailwind CSS 3.x",
      "components": "Shadcn UI (Tailwind v3 compatible CLI: shadcn@2.3.0)",
      "state": "Zustand 4.x",
      "animations": "Framer Motion 11.x"
    },
    "testing": {
      "unit": "Jest 29.x",
      "integration": "Supertest (Latest)",
      "e2e": "Playwright (Latest)",
      "api": "Postman/Newman"
    },
    "devops": {
      "ci_cd": "GitHub Actions",
      "containerization": "Docker + Docker Compose (optional)",
      "monitoring": "Prometheus + Grafana (optional)",
      "logging": "Winston 3.x (+ Datadog / ELK / CloudWatch if chosen)"
    }
  },
  "paths": {
    "agents": ".ai/agents",
    "skills": ".ai/skills",
    "workflows": ".ai/workflows",
    "context": ".ai/context",
    "memory": ".ai/memory",
    "project_management": ".ai/project-management",
    "templates": ".ai/templates",
    "prd": "doc/prd.md",
    "source_backend": "codebase/backend",
    "source_frontend": "codebase/frontend"
  },
  "test_layout": {
    "backend_unit": "codebase/backend/src/**/*.spec.ts",
    "backend_integration": "codebase/backend/test/integration/**/*.e2e-spec.ts",
    "backend_api_contract": "codebase/backend/test/api/**/*.api-spec.ts",
    "frontend_unit": "codebase/frontend/src/**/*.test.tsx",
    "frontend_e2e": "codebase/frontend/e2e/**/*.spec.ts"
  },
  "git_remotes": {}
}
